# Copy to backend/config/.env and adjust. This file is never served (outside public/).
APP_ENV=development
# URL prefix under which Apache serves backend/public (see docs/setup.md)
APP_BASE_PATH=/webforge

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webforge
DB_USER=root
DB_PASS=

SESSION_NAME=WEBFORGE_SID
SESSION_IDLE_MINUTES=60
