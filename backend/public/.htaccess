# Route every request that is not a real file to the front controller.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # The Apache Alias for the API (backend/config/apache-webforge.conf): APP_BASE_PATH + "/api/"
    RewriteBase /webforge/api/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Security headers are sent by Response::send() for every API response.
